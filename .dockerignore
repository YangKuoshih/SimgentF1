# ==============================================================================
# F1 Simgent - Docker Container Ignore Rules
# Excludes local secrets, git history, and development dependencies from images
# ==============================================================================

# Environments & Local Secrets
.venv/
venv/
env/
.env*
*.env
application_default_credentials.json
*-sa-key*.json
*service_account*.json
*credentials*.json
credentials.json
client_secret*.json
*secret*.json
*gcp*.json
*.pem
*.key
*.token

# Git & CI/CD
.git/
.gitignore
.github/

# Bytecode & Caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

