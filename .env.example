# ==============================================================================
# SimGent — Environment Configuration Template
# ==============================================================================
# Copy this file to .env:
#   cp .env.example .env
#
# Model API keys are optional; admin endpoints require a configured admin token.
# SimGent is engineered to operate out-of-the-box with ZERO API keys using its
# local deterministic telemetry engine and grounded in-memory transponders (no external model call).
# ==============================================================================

# Costs depend on your provider account, usage, hosting and local hardware.
# This template does not guarantee free operation or a zero cloud bill.

# --- SI & LLM Copilot Providers (Optional) ---
# Groq (account-specific pricing and quotas)
# Obtain your key at: https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini / Gemma via Google AI Studio Free Tier ($0 on an unbilled AI Studio project)
# Obtain your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Free-tier model cascade on Google AI Studio (1,000 RPD Flash-Lite -> 14,400 RPD Gemma 3 27B -> 250 RPD Flash)
GEMINI_MODELS=gemini-2.5-flash-lite,gemma-3-27b-it,gemini-2.5-flash

# Local Ollama Host (local inference; hardware and electricity costs apply)
# Default: http://localhost:11434
OLLAMA_HOST=http://localhost:11434

# Provider Priority Selection: "auto", "local", "groq", "gemini", or "ollama"
# "auto" will prioritize configured keys, falling back to local engine safely.
LLM_PROVIDER=auto

# --- Server & Port Configuration ---
PORT=8080
HOST=0.0.0.0

# Admin endpoints are disabled when this is empty. Supply through the process
# environment or your hosting secret manager; never put it in frontend code.
SIMGENT_ADMIN_TOKEN=
# Optional private writable directory. Default: data/runtime/ (Git/build ignored).
# Cloud Run local files are ephemeral; use durable private storage if needed.
# SIMGENT_RUNTIME_DIR=/path/to/private/runtime
